{
  "name": "aws-rex",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for independent source repos under source-repos/. Not a product; not a published package.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12.6.0"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint -- --fix",
    "format": "pnpm -r --if-present run format && prettier --write .",
    "format:check": "pnpm -r --if-present run format:check && prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev:dashboard": "pnpm --filter @aws-rex/dashboard dev",
    "dev:marketing": "pnpm --filter @aws-rex/marketing-site dev"
  },
  "prettier": "@aws-rex/config/prettier",
  "devDependencies": {
    "@aws-rex/config": "^1.0.0",
    "prettier": "^3.9.9"
  }
}
